generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String

  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  email_verified_at DateTime?
  email_verify_code String?
  email_verify_exp  DateTime?

  messages        Message[]
  memberships     ChatRoomMember[]
  refresh_tokens  RefreshToken[]

  friendships_sent     Friendship[] @relation("FriendshipFrom")
  friendships_received Friendship[] @relation("FriendshipTo")

  @@map("users")
}

model ChatRoom {
  id           Int      @id @default(autoincrement())
  name         String?
  is_group     Boolean  @default(false)
  private_key  String?  @unique
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  members   ChatRoomMember[]
  messages  Message[]

  @@map("chat_rooms")
}

model ChatRoomMember {
  id         Int      @id @default(autoincrement())
  room_id    Int
  user_id    Int
  created_at DateTime @default(now())

  room ChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([room_id, user_id])
  @@map("chat_room_members")
}

model Message {
  id         Int      @id @default(autoincrement())
  room_id    Int
  user_id    Int
  content    String?
  kind       String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  room ChatRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  user User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([room_id, created_at])
  @@map("messages")
}

model RefreshToken {
  id          Int      @id @default(autoincrement())
  user_id     Int
  token_hash  String   @unique
  revoked_at  DateTime?
  expires_at  DateTime
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, expires_at])
  @@map("refresh_tokens")
}

model Friendship {
  id           Int      @id @default(autoincrement())
  from_user_id Int
  to_user_id   Int
  status       String   @default("pending")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  from_user User @relation("FriendshipFrom", fields: [from_user_id], references: [id])
  to_user   User @relation("FriendshipTo",   fields: [to_user_id],   references: [id])

  @@unique([from_user_id, to_user_id])
  @@index([to_user_id, status])
  @@map("friendships")
}